# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=your_postgres_connection_string

# Secret used to sign JWTs — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 64 characters recommended. Server will refuse to start if this is missing.
JWT_SECRET=your_jwt_secret_min_64_chars

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# Origin the React client is served from (allowed by CORS, and used as the base
# for password-reset links). In production set this to the deployed client URL,
# e.g. https://autoserve-three.vercel.app — no trailing slash, no path.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed CORS origins (optional)
# CLIENT_URL=https://app.example.com,https://staging.example.com

# ── Email (Brevo transactional) ───────────────────────────────────────────────
# Obtain from https://app.brevo.com/settings/keys/api
# If absent, password-reset emails will fail silently (the server will still run)
BREVO_API_KEY=your_brevo_api_key
